<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Queries for AppLauncher to resolve geo: URIs and Google Maps URLs on Android 11+ -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="geo" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" android:host="maps.google.com" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" android:host="www.google.com" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" android:host="maps.app.goo.gl" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" android:host="goo.gl" />
        </intent>
    </queries>

    <application
        android:name=".FindbackApp"
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="${findbackShareHost}" android:pathPrefix="/r/" />
            </intent-filter>

        </activity>

        <!--
          Keyless MapLibre map surface (MAP pivot): the picker/viewer Activity
          owns its own view hierarchy — never embedded under the WebView.
          Not exported (launched only from this app's Capacitor bridge).
        -->
        <activity
            android:name=".map.FindbackMapActivity"
            android:theme="@style/AppTheme.NoActionBar"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>

        <!--
          Native Google Maps / Places API key (A3). Injected by Gradle from
          GOOGLE_MAPS_API_KEY (see app/build.gradle); empty when the owner has
          not provided one — the map surfaces fail closed at runtime. Create
          the restricted key per docs/runbooks/google-maps-key.md; never
          hard-code a real value here.
        -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="${googleMapsApiKey}" />

        <!--
          FindBack owns FCM presentation: the Capacitor plugin's service is
          removed so data-only messages can be shown with a RemoteInput reply
          action. The service still forwards to the plugin for foreground JS
          events and token registration.
        -->
        <service
            android:name="com.capacitorjs.plugins.pushnotifications.MessagingService"
            tools:node="remove" />
        <service
            android:name=".push.FindbackMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- Receives the notification-shade reply text and posts it. -->
        <receiver
            android:name=".push.ReplyReceiver"
            android:exported="false" />

        <!--
          LiteRT-LM GPU path (SmolVLM2 vision resident). Optional shared
          libraries the GPU delegate loads at runtime; required=false so
          devices without them install and run the CPU path normally.
        -->
        <uses-native-library android:name="libvndksupport.so" android:required="false" />
        <uses-native-library android:name="libOpenCL.so" android:required="false" />

    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Android 13+ runtime permission for the push notification service. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!--
      One-time coarse location for "Use my location once" (report pin).
      Both entries are required: Capacitor's BridgeWebChromeClient requests
      ACCESS_COARSE_LOCATION + ACCESS_FINE_LOCATION together and only falls
      back to COARSE-only on API 31+ (bridge code). This app targets
      minSdk 24, so dropping ACCESS_FINE_LOCATION would deny geolocation
      outright on API 24-30. The WebView options are coarse
      (enableHighAccuracy: false), so no precise fix is requested in JS.
    -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!--
      Microphone for on-device dictation (V1 SpeechInput bridge). Required in
      the manifest: Capacitor's Bridge.validatePermissions rejects the saved
      permission call when a @Permission string is not manifest-declared, so
      the @PermissionCallback would never run without this entry.
    -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
</manifest>
