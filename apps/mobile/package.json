{
  "name": "@findback/mobile",
  "private": true,
  "version": "0.6.0-beta.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "cap:add:android": "cap add android",
    "cap:sync": "cap sync android",
    "apk": "node ../../scripts/check-mobile-build-config.mjs --assets dist/assets && cap sync android && cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.1",
    "@capacitor/app": "^8.1.1",
    "@capacitor/app-launcher": "^8.0.1",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/camera": "^8.2.4",
    "@capacitor/core": "^8.5.1",
    "@capacitor/geolocation": "^8.1.0",
    "@capacitor/push-notifications": "^8.1.2",
    "@findback/shared": "*",
    "@floating-ui/react": "^0.27.20",
    "@internationalized/date": "^3.12.4",
    "@sentry/capacitor": "^4.4.0",
    "@sentry/react": "^10.69.0",
    "@supabase/supabase-js": "2.116.0",
    "@tiptap/core": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "framer-motion": "^13.2.0",
    "lucide-react": "^1.43.0",
    "maplibre-gl": "^6.10.0",
    "react": "^19.2.8",
    "react-aria-components": "^1.21.1",
    "react-dom": "^19.2.8",
    "react-markdown": "10.1.0",
    "react-router": "^8.3.1",
    "rehype-sanitize": "6.0.0",
    "remark-breaks": "4.0.0",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "vite": "^8.2.2"
  }
