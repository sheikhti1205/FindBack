# FindBack — example environment. Copy to `.env` in the REPO ROOT and fill in
# real values. The API auto-loads `<repo>/.env` regardless of cwd (there is no
# services/api/.env). NEVER commit the real `.env` (it is gitignored).

# ---- API server ----
PORT=4000
HOST=0.0.0.0
NODE_ENV=development
# Used ONLY by LocalAuthProvider (tests + local demo). Production Supabase Auth
# does not use JWT_SECRET.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
PUBLIC_URL=http://localhost:4000
# Serve a built web shell at "/" (optional, single-container demo)
# STATIC_WEB_DIR=apps/mobile/dist

# ---- Database provider ----
# supabase (real application backend) | sqlite (tests + local demo only)
# Automated tests are always pinned to in-memory SQLite regardless of this value.
DB_PROVIDER=supabase
# SQLite file, used only when DB_PROVIDER=sqlite (local demo, not tests)
# DB_FILE=services/api/data/findback.db

# ---- Supabase Data API (real application backend) ----
# The Node API uses @supabase/supabase-js against the Supabase Data API.
# SUPABASE_URL is the project URL (safe to share).
SUPABASE_URL=https://<project-ref>.supabase.co
# Backend-ONLY key. Bypasses RLS. Never expose to the mobile app, any VITE_*
# variable, API responses, logs, or build output.
SUPABASE_SECRET_KEY=
# Publishable (anon) key. The Node API performs user Auth operations with it and
# validates JWTs via JWKS. This is a public client value: the mobile app uses the
# same class of key via VITE_SUPABASE_PUBLISHABLE_KEY. Never put the
# secret/service-role key in any VITE_* variable.
SUPABASE_PUBLISHABLE_KEY=
# Optional: JWKS URL used by the backend to verify access tokens. The mobile app
# calls Supabase Auth directly, but access-token verification stays on the backend.
# SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json

# ---- Mobile app (Vite build-time, PUBLIC) ----
# Bundled into the client, so these are public values. Use the publishable key
# only — never the secret/service-role key.
# Local builds also accept SUPABASE_URL / SUPABASE_PUBLISHABLE_KEY above;
# blank VITE_* entries here will not override populated canonical values.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Canonical public HTTPS host (also required by Android App Links and release builds).
VITE_PUBLIC_SHARE_ORIGIN=https://findbackapp.social

# ---- Google Sign-In (Android Credential Manager, PUBLIC client config) ----
# The WEB/server OAuth client ID (NOT the Android client ID) is the Credential
# Manager audience. It reaches the APK via BuildConfig.GOOGLE_WEB_CLIENT_ID
# (Gradle reads the GOOGLE_WEB_CLIENT_ID env var). Public identifier — safe to
# ship in the APK. The Google CLIENT SECRET never belongs here: it lives only in
# the Supabase Google-provider dashboard.
# Missing value = Google sign-in hidden/disabled (fail-closed). `signeddev` and
# `release` builds (`npm run apk` with --variant) require it.
GOOGLE_WEB_CLIENT_ID=

# ---- Keyless map style (MapLibre Native, NON-SECRET provider config) ----
# MapLibre-compatible style URL rendered by the native picker, viewer, and
# post snapshots. Default (when empty) is the owner-decided OpenFreeMap
# Liberty style. A public style endpoint — safe to share, safe to log, never
# a credential. See docs/runbooks/maplibre-native.md.
# FINDBACK_MAP_STYLE_URL=

# ---- Crash reporting (Sentry Capacitor SDK, PUBLIC client config) ----
# Empty = monitoring disabled (default for local dev and unit tests). The DSN starts with
# https:// and is safe to ship in the client bundle.
# Sourcemap upload uses SENTRY_AUTH_TOKEN as a CI secret — never a VITE_* var.
VITE_SENTRY_DSN=
# Defaults to the Vite mode when empty, e.g. development/production.
VITE_SENTRY_ENVIRONMENT=
# Fraction of transactions traced (0-1). Conservative default when empty: 0.1.
# Session replay stays disabled; request bodies are never attached.
VITE_SENTRY_TRACES_SAMPLE_RATE=
# Sentry org/project slugs (plain identifier strings for the CI sourcemap-upload step).
# SENTRY_AUTH_TOKEN itself is a CI SECRET — never put it in any file or VITE_* variable.
# SENTRY_ORG=
# SENTRY_PROJECT=
# One-tap monitoring self-test trigger for device verification. Empty = hidden (default).
# Set to "true" to show a diagnostics button in Profile that sends a synthetic
# test signal to Sentry (tagged `monitoringSelfTest: findback-monitoring-self-test`).
# Used once for the owner's Sentry device proof; not for production.
VITE_MONITORING_SELFTEST=
#
# Local env contract for `npm run apk` (fail-closed preflight in scripts/build-apk.mjs):
# installable builds REQUIRE a real VITE_SENTRY_DSN. It is embedded from shell
# exports (highest precedence — this is what the preflight enforces) or from
# apps/mobile/.env* files (import.meta.env, envDir apps/mobile). A VITE_SENTRY_DSN
# in the repo-root .env is NOT embedded — root .env only feeds the Supabase
# `define`s via vite.config loadEnv. Unit tests and `vite dev` run DSN-free
# with monitoring inert (no telemetry attempted).

# ---- Uploads ----
# UPLOADS_DIR=services/api/uploads

# ---- Sourcemap upload (S3: Sentry debug info for release builds) ----
# Release builds emit hidden sourcemaps ONLY when SENTRY_UPLOAD_SOURCEMAPS=true
# (set by the release workflow for that build alone). Local builds emit no .map
# files at all, so a missing token can never leak maps — there is nothing to
# upload, strip, or package, and the build log says so explicitly.
# The workflow uploads dist maps with SENTRY_AUTH_TOKEN, then deletes every
# *.map before Capacitor sync (a workflow step fails the job if any remain).
# SENTRY_AUTH_TOKEN lives ONLY as a CI secret
# (repo Settings → Secrets and variables → Actions → Secrets) — never in any
# file or VITE_* variable. SENTRY_ORG/SENTRY_PROJECT are plain variables (above).
# SENTRY_UPLOAD_SOURCEMAPS=true
# VITE_SENTRY_RELEASE is computed per build as
# findback-mobile@<apps/mobile version>+<git short SHA> and must equal the
# --release passed to the upload (see apps/mobile/src/services/monitoring/release.ts).

# ---- AI help assistant (optional) ----
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=
# LLM_MODEL=gpt-4o-mini
