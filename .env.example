# FindBack — example environment. Copy to `.env` in the REPO ROOT and fill in
# real values. The API auto-loads `<repo>/.env` regardless of cwd (there is no
# services/api/.env). NEVER commit the real `.env` (it is gitignored).

# ---- API server ----
PORT=4000
HOST=0.0.0.0
NODE_ENV=development
# Dev-only default is used when unset; set a long random value outside local dev.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
PUBLIC_URL=http://localhost:4000
# Serve a built web shell at "/" (optional, single-container demo)
# STATIC_WEB_DIR=apps/mobile/dist

# ---- Database provider ----
# sqlite (default: in-memory test harness + local dev) | supabase (real app)
DB_PROVIDER=sqlite
# SQLite file, used when DB_PROVIDER=sqlite
# DB_FILE=services/api/data/findback.db

# ---- Supabase Data API (real application backend) ----
# The Node API uses @supabase/supabase-js with the backend-only secret key.
# SUPABASE_URL is the project URL (safe to share).
SUPABASE_URL=https://<project-ref>.supabase.co
# Backend-ONLY key. Bypasses RLS. Never expose to the mobile app, any VITE_*
# variable, API responses, logs, or build output.
SUPABASE_SECRET_KEY=
# Public keys (mobile/web use a separate Supabase client in a later phase).
# SUPABASE_PUBLISHABLE_KEY=<publishable-anon-key>
# SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json

# ---- Legacy direct PostgreSQL (deprecated; do not use for runtime) ----
# Only used if DB_PROVIDER=postgres. Being removed after SupabaseStore lands.
# DATABASE_URL=postgresql://postgres:<DB_PASSWORD>@<host>:5432/postgres

# ---- Uploads ----
# UPLOADS_DIR=services/api/uploads

# ---- AI help assistant (optional) ----
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=
# LLM_MODEL=gpt-4o-mini
