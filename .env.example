# FindBack — example environment. Copy to `.env` and fill in real values.
# NEVER commit the real `.env` (it is gitignored).

# ---- API server ----
PORT=4000
HOST=0.0.0.0
NODE_ENV=development
# Dev-only default is used when unset; set a long random value outside local dev.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
PUBLIC_URL=http://localhost:4000
# Serve a built web shell at "/" (optional, single-container demo)
# STATIC_WEB_DIR=apps/mobile/dist

# ---- Database provider ----
# sqlite (default, local demo) | postgres (Supabase)
DB_PROVIDER=sqlite
# SQLite file, used when DB_PROVIDER=sqlite
# DB_FILE=services/api/data/findback.db
# PostgreSQL / Supabase connection URI, used when DB_PROVIDER=postgres.
# Get it from Supabase → Project Settings → Database → Connection string (URI).
# It contains the database password — treat as a secret.
# DATABASE_URL=postgresql://postgres:<DB_PASSWORD>@<host>:5432/postgres

# ---- Uploads ----
# UPLOADS_DIR=services/api/uploads

# ---- AI help assistant (optional) ----
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=
# LLM_MODEL=gpt-4o-mini

# ---- Supabase (reserved for the Auth/Storage phase; not used by the DB adapter) ----
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_PUBLISHABLE_KEY=<publishable-anon-key>
# Server-only key; never expose to the mobile app or commit it.
# SUPABASE_SECRET_KEY=
